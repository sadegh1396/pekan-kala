generator client {
 provider = "prisma-client-js"
 engineType = "client"
}
datasource db {
 provider = "sqlite"
 url = env("DATABASE_URL")
}
model Product {
 id String @id
 name String
 en String
 price Int
 old Int?
 category String
 range String
 power String
 tag String
 color String
 image String @default("")
 stock Int @default(0)
 active Boolean @default(true)
}
model Admin {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 role String @default("ADMIN")
 sessions Session[]
}
model Session {
 tokenHash String @id
 adminId String
 admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
 expiresAt DateTime
}
model LoginAttempt {
 key String @id
 count Int @default(0)
 resetAt DateTime
}
model Order {
 id String @id @default(cuid())
 customer String
 phone String
 address String
 total Int
 status String @default("PENDING")
 createdAt DateTime @default(now())
 items OrderItem[]
 reservation Reservation?
}
model OrderItem {
 id String @id @default(cuid())
 orderId String
 order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
 productId String
 name String
 price Int
 quantity Int
}
model Reservation {
 id String @id @default(cuid())
 orderId String @unique
 order Order @relation(fields: [orderId], references: [id])
 requestedDate String
 status String @default("PENDING")
 createdAt DateTime @default(now())
}
